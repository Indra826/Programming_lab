// ===== REGISTRATION =====
void registerUser(struct User users[],
int *totalUsers){

if(*totalUsers >= MAX_USERS){  

    printf("User Limit Reached!\n");  

    return;  
}  

printf("\n===== USER REGISTRATION =====\n");  

printf("Enter Username: ");  

scanf("%49s",  
      users[*totalUsers].username);  

printf("Enter Password: ");  

scanf("%49s",  
      users[*totalUsers].password);  

(*totalUsers)++;  

printf("Registration Successful!\n");

}

// ===== LOGIN =====
int login(struct User users[],
int totalUsers){

char username[50];  
char password[50];  

printf("\n===== USER LOGIN =====\n");  

printf("Enter Username: ");  

scanf("%49s", username);  

printf("Enter Password: ");  

scanf("%49s", password);  

for(int i = 0; i < totalUsers; i++){  

    if(strcmp(users[i].username,  
              username) == 0 &&  

       strcmp(users[i].password,  
              password) == 0){  

        printf("Login Successful!\n");  

        return 1;  
    }  
}  

printf("Invalid Username or Password!\n");  

return 0;

}

// ===== VIEW BUSES =====
void viewBuses(struct Bus buses[],
int totalBuses){

printf("\n========== AVAILABLE BUSES ==========\n");  

for(int i = 0; i < totalBuses; i++){  

    printf("\nBus Number    : %d\n",  
           buses[i].busNumber);  

    printf("Bus Name      : %s\n",  
           buses[i].busName);  

    printf("Route         : %s -> %s\n",  
