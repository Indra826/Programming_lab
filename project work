while(1){  

    // ===== MAIN MENU =====  
    if(loggedIn == 0){  

        int choice;  

        displayMainMenu();  

        scanf("%d",  
              &choice);  

        switch(choice){  

            case 1:  

                registerUser(users,  
                             &totalUsers);  

                break;  

            case 2:  

