            default:  

                printf("Invalid Choice!\n");  
        }  
    }  

    // ===== USER PANEL =====  
    else{  

        int choice;  

        displayUserMenu();  

        scanf("%d",  
              &choice);  

        switch(choice){  

            case 1:  

                viewBuses(buses,  
                          totalBuses);  

                break;  

            case 2:  

                bookTicket(buses,  
                           totalBuses,  
                           r,  
                           &reservationCount);  

                break;  

            case 3:  

                cancelTicket(buses,  
                             totalBuses,  
                             r,  
                             &reservationCount);  

                break;  

            case 4:  

                viewReservations(r,  
                                 reservationCount);  

                break;  

            case 5:  

                loggedIn = 0;  

                printf("Logged Out Successfully!\n");  

                break;  

            default:  

                printf("Invalid Choice!\n");  
        }  
    }  
}  

return 0;

}
