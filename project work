}

}

// ===== SHOW AVAILABLE SEATS =====
void showAvailableSeats(struct Reservation r[],
int reservationCount,
int busNo){

printf("\nAvailable Seats:\n");  

for(char row = 'A'; row <= 'J'; row++){  

    for(int num = 1; num <= 4; num++){  

        char seat[10];  

        sprintf(seat,  
                "%c%d",  
                row,  
                num);  

        int booked = 0;  

        for(int i = 0;  
            i < reservationCount;  
            i++){  

            if(r[i].busNumber == busNo &&  

               strcmp(r[i].seatNo,  
                      seat) == 0){  

                booked = 1;  

                break;  
            }  
        }  

        if(booked == 0){  

            printf("%s ",  
                   seat);  
        }  
    }  

    printf("\n");  
}

}

// ===== BOOK TICKET =====
void bookTicket(struct Bus buses[],
int totalBuses,
struct Reservation r[],
int *reservationCount){

int busNo;  
int seats;  

if(*reservationCount >= MAX_RESERVATIONS){  

    printf("Reservation Limit Reached!\n");  

    return;  
}  

printf("\nEnter Bus Number: ");  

scanf("%d",  
      &busNo);  

for(int i = 0; i < totalBuses; i++){  

    if(buses[i].busNumber == busNo){  

        printf("\n===== BUS DETAILS =====\n");  

        printf("Bus Name      : %s\n",  
               buses[i].busName);  

        printf("Route         : %s -> %s\n",  
               buses[i].source,  
               buses[i].destination);  

        printf("Available     : %d\n",  
               buses[i].availableSeats);  

        printf("Ticket Price  : %.2f\n",  
               buses[i].ticketPrice);  

        showAvailableSeats(r,  
                           *reservationCount,  
                           busNo);  

        printf("\nEnter Seats to Book: ");  

        scanf("%d",  
              &seats);  

        if(seats <= 0 ||  

           seats > buses[i].availableSeats){  

            printf("Invalid Seat Amount!\n");  

            return;  
        }  

        for(int j = 0; j < seats; j++){  

            printf("\nEnter Passenger Name: ");  

            scanf(" %[^\n]",  
                  r[*reservationCount].  
                  passengerName);  

            printf("Enter Seat Number: ");  

            scanf("%9s",  
                  r[*reservationCount].  
                  seatNo);  

            int seatExists = 0;  

            // CHECK DUPLICATE SEAT  
            for(int k = 0;  
                k < *reservationCount;  
                k++){  

                if(r[k].busNumber == busNo &&  

                   strcmp(r[k].seatNo,  
                          r[*reservationCount].  
                          seatNo) == 0){  

                    seatExists = 1;  

                    break;  
                }  
            }  

            if(seatExists == 1){  

                printf("Seat Already Booked!\n");  

                j--;  

                continue;  
            }  

            r[*reservationCount].  
            busNumber = busNo;  

            strcpy(r[*reservationCount].source,  
                   buses[i].source);  

            strcpy(r[*reservationCount].destination,  
                   buses[i].destination);  

            (*reservationCount)++;  
        }  

        buses[i].availableSeats -= seats;  

        float totalFare =  
            seats *  
            buses[i].ticketPrice;  

        printf("\n===== BOOKING SUCCESSFUL =====\n");  

        printf("Seats Booked : %d\n",  
               seats);  

        printf("Total Fare   : %.2f\n",  
               totalFare);  

        return;  
    }  
}  

printf("Bus Not Found!\n");

}

// ===== CANCEL TICKET =====
void cancelTicket(struct Bus buses[],
int totalBuses,
struct Reservation r[],
int *reservationCount){

char seatNo[10];  
int busNo;  

printf("\nEnter Bus Number: ");  

scanf("%d",  
      &busNo);  

printf("Enter Seat Number to Cancel: ");  

scanf("%9s",  
      seatNo);  

for(int i = 0;  
    i < *reservationCount;  
    i++){  

    if(r[i].busNumber == busNo &&  

       strcmp(r[i].seatNo,  
              seatNo) == 0){  

        // RETURN SEAT  
        for(int j = 0;  
            j < totalBuses;  
            j++){  

            if(buses[j].busNumber ==  
               busNo){  

                buses[j].availableSeats++;  

                break;  
            }  
        }  

        // DELETE RESERVATION  
        for(int j = i;  
            j < *reservationCount - 1;  
            j++){  

            r[j] = r[j + 1];  
        }  

        (*reservationCount)--;  

        printf("Ticket Cancelled Successfully!\n");  

        return;  
    }  
}  

printf("Reservation Not Found!\n");

}

// ===== VIEW RESERVATIONS =====
void viewReservations(struct Reservation r[],
int reservationCount){

if(reservationCount == 0){  

    printf("\nNo Reservations Found!\n");  

    return;  
}  

printf("\n========== ALL RESERVATIONS ==========\n\n");  

printf("%-10s %-20s %-15s %-15s\n",  
       "Seat No",  
       "Passenger Name",  
       "Source",  
       "Destination");  

printf("---------------------------------------------------------------\n");  

for(int i = 0;  
    i < reservationCount;  
    i++){  

    printf("%-10s %-20s %-15s %-15s\n",  

           r[i].seatNo,  

           r[i].passengerName,  

           r[i].source,  

           r[i].destination);  
}

}

