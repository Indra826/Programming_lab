#include<stdio.h>
#include<stdlib.h>
#include<string.h>

#define MAX_USERS 100
#define MAX_BUSES 10
#define MAX_RESERVATIONS 100

// ===== BUS STRUCTURE =====
struct Bus{

int busNumber;  
char busName[50];  
char source[50];  
char destination[50];  
char departureTime[20];  
char arrivalTime[20];  
int totalSeats;  
int availableSeats;  
float ticketPrice;

};

// ===== USER STRUCTURE =====
struct User{

char username[50];  
char password[50];

};

// ===== RESERVATION STRUCTURE =====
struct Reservation{

int busNumber;  

char seatNo[10];  
char passengerName[50];  
char source[50];  
char destination[50];

};

